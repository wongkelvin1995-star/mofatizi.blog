---
import { MAIN_NAV, SITE_CONFIG } from '../data/site-config';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-[#E2E8F0]/90 bg-[#F8FAFF]/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <!-- Brand Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2.5 rounded-xl py-1 pr-2 transition hover:opacity-90">
      <img src="/logo.svg" alt="魔法梯子 Magic Ladder Logo" width="38" height="38" class="h-9 w-9 shrink-0 rounded-xl shadow-xs" />
      <div class="leading-tight">
        <span class="block text-base font-bold tracking-tight text-[#252D49]">{SITE_CONFIG.siteName}</span>
        <span class="block text-[11px] font-semibold tracking-wider text-[#7664D9] uppercase">Magic Ladder</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="主导航" class="hidden items-center gap-1 lg:flex">
      {MAIN_NAV.filter((item) => item.href !== '/search/').map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return item.children ? (
          <div class="group relative">
            <a
              href={item.href}
              class:list={[
                'inline-flex min-h-[40px] items-center gap-1 rounded-xl px-3 py-1.5 text-sm font-semibold transition',
                isActive ? 'bg-[#F0EBFF] text-[#5B48C4]' : 'text-[#252D49] hover:bg-[#F0EBFF]/70 hover:text-[#5B48C4]',
              ]}
            >
              {item.label}
              <svg class="h-3.5 w-3.5 text-[#64748B] transition group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="w-64 rounded-2xl border border-[#E2E8F0] bg-white p-2 shadow-xl">
                {item.children.map((sub) => (
                  <a
                    href={sub.href}
                    class="block rounded-xl px-3 py-2 transition hover:bg-[#F0EBFF]/70"
                  >
                    <span class="block text-sm font-semibold text-[#252D49]">{sub.label}</span>
                    {sub.desc && <span class="block text-xs text-[#64748B]">{sub.desc}</span>}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'inline-flex min-h-[40px] items-center rounded-xl px-3 py-1.5 text-sm font-semibold transition',
              isActive ? 'bg-[#F0EBFF] text-[#5B48C4]' : 'text-[#252D49] hover:bg-[#F0EBFF]/70 hover:text-[#5B48C4]',
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Actions: Search + Mobile Menu -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-open-search
        aria-label="打开全站中文搜索"
        class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-[#E2E8F0] bg-white px-3.5 text-sm font-semibold text-[#252D49] shadow-xs transition hover:border-[#7664D9] hover:bg-[#F0EBFF]/50"
      >
        <svg class="h-4 w-4 text-[#7664D9]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
        </svg>
        <span class="hidden sm:inline">搜索知识/品牌</span>
        <span class="sm:hidden">搜索</span>
      </button>

      <a
        href="/search/"
        class="hidden min-h-[44px] items-center rounded-xl bg-[#F0EBFF] px-3 text-sm font-semibold text-[#5B48C4] transition hover:bg-[#E4DCFF] xl:inline-flex"
      >
        完整检索页
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="展开导航菜单"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-xl border border-[#E2E8F0] bg-white text-[#252D49] lg:hidden"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="hidden border-t border-[#E2E8F0] bg-white px-4 py-4 lg:hidden">
    <div class="mx-auto max-w-2xl space-y-2">
      {MAIN_NAV.map((item) =>
        item.children ? (
          <details class="rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] px-3 py-2">
            <summary class="flex min-h-[40px] cursor-pointer items-center justify-between text-sm font-bold text-[#252D49]">
              <span>{item.label}</span>
              <span class="text-xs font-medium text-[#7664D9]">展开</span>
            </summary>
            <div class="mt-2 grid grid-cols-1 gap-1 border-t border-[#E2E8F0] pt-2">
              <a href={item.href} class="rounded-lg px-2.5 py-2 text-sm font-semibold text-[#5B48C4] hover:bg-white">
                进入{item.label}总览 →
              </a>
              {item.children.map((sub) => (
                <a href={sub.href} class="rounded-lg px-2.5 py-2 text-sm text-[#334155] hover:bg-white">
                  {sub.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class="flex min-h-[44px] items-center rounded-xl border border-[#E2E8F0] bg-[#F8FAFF] px-3.5 text-sm font-bold text-[#252D49]"
          >
            {item.label}
          </a>
        )
      )}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('mobile-menu-toggle');
    var drawer = document.getElementById('mobile-nav-drawer');
    if (btn && drawer) {
      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        drawer.classList.toggle('hidden');
      });
    }
  })();
</script>
