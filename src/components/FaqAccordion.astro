---
export interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item, idx) => (
    <details
      open={idx === 0}
      class="group rounded-2xl border border-[#E2E8F0] bg-[#F8FAFF] transition open:border-[#7664D9]/50 open:bg-white"
    >
      <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 text-sm font-bold text-[#252D49] sm:text-base">
        <span>{item.question}</span>
        <span class="shrink-0 rounded-full bg-[#F0EBFF] px-2.5 py-0.5 text-xs font-semibold text-[#5B48C4] transition group-open:bg-[#7664D9] group-open:text-white">
          <span class="group-open:hidden">展开</span>
          <span class="hidden group-open:inline">收起</span>
        </span>
      </summary>
      <div class="border-t border-[#E2E8F0]/70 px-4 py-3.5 text-sm leading-relaxed text-[#334155]">
        {item.answer}
      </div>
    </details>
  ))}
</div>
