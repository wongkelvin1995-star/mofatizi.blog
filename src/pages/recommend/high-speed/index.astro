---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { SITE_CONFIG } from '../../../data/site-config';

const entry = await getEntry('guides', 'high-speed-ladder-guide');
if (!entry) throw new Error('Missing high-speed-ladder-guide');
const { Content, headings } = await render(entry);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    dateModified: entry.data.updatedDate,
    author: { '@type': 'Organization', name: SITE_CONFIG.siteName },
    mainEntityOfPage: `${SITE_CONFIG.domain}/recommend/high-speed/`,
  },
  ...(entry.data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: entry.data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.question,
            acceptedAnswer: { '@type': 'Answer', text: f.answer },
          })),
        },
      ]
    : []),
];
---

<ArticleLayout
  title={entry.data.title}
  h1={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  canonicalPath="/recommend/high-speed/"
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '梯子推荐', href: '/recommend/' },
    { label: '高速梯子推荐' },
  ]}
  headings={headings}
  faqs={entry.data.faqs}
  sources={entry.data.sources}
  relatedLinks={[
    { label: '稳定梯子选择标准', href: '/recommend/reliable/', tag: '稳定性原理' },
    { label: 'Clash TUN 模式设置', href: '/clash/tun/', tag: '协议栈调优' },
    { label: '梯子节点切换指南', href: '/guides/switch-nodes/', tag: '节点选择' },
  ]}
  jsonLd={jsonLd}
>
  <Content />
</ArticleLayout>
