---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ClientSelector from '../../components/ClientSelector.astro';
---

<BaseLayout
  title="代理客户端大全与魔法客户端选择助手：Clash/Shadowrocket/v2rayN/sing-box｜魔法梯子"
  description="汇总 10 款经过官方 GitHub 仓库与 App Store 核验的开源及原生代理客户端，内置按 Windows/macOS/iOS/Android/Linux/OpenWrt 实时筛选的选择助手。"
  canonicalPath="/clients/"
>
  <section class="bg-magic-clients border-b border-[#E2E8F0] py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '客户端大全与选择助手' }]} />
      <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.2fr)_320px]">
        <div>
          <span class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-bold text-[#5B48C4] shadow-2xs">
            赛博魔法客户端百科 · 10 款经核验工具
          </span>
          <h1 class="mt-3 text-3xl font-extrabold text-[#252D49] sm:text-4xl">
            魔法客户端中心与系统选择助手
          </h1>
          <p class="mt-3 text-base leading-relaxed text-[#334155]">
            所有收录客户端均逐字核对了官方 GitHub 仓库或 Apple App Store 发行主体，严格限定于有官方构建包支持的操作系统，不提供任何来路不明的修改版链接，也不将品牌推广注册网址充当软件下载地址。
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="#client-assistant" class="btn-magic-primary">立即按系统筛选客户端</a>
            <a href="/clash/airports/" class="btn-magic-secondary">核对机场订阅开放情况 →</a>
          </div>
        </div>

        <div class="rounded-3xl border border-white bg-white/85 p-3 shadow-md">
          <img
            src="/illustrations/clients-cyber-mage.webp"
            alt="赛博魔法少女操控全息网络工具面板插画"
            width="760"
            height="570"
            class="h-auto w-full rounded-2xl object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ClientSelector />

      <div class="mt-10 rounded-3xl border border-[#E2E8F0] bg-white p-6 shadow-xs sm:p-8">
        <h2 class="text-xl font-bold text-[#252D49]">客户端选择前的重要兼容性提示</h2>
        <p class="mt-2 text-sm leading-relaxed text-[#334155]">
          第三方客户端的强大依赖于机场是否提供对应格式的订阅链接。如果目标品牌当前采用官方专属客户端或 iOS Nextin 接入模式（例如飞猫云、唯兔云、灵猫、无忧链接、Firefly、闪跃新订单与光速云），则应直接使用品牌用户中心下发的官方软件，而非强行套用第三方订阅导入流程。
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/knowledge/official-vs-third-party-clients/" class="text-xs font-bold text-[#5B48C4] hover:underline">
            官方客户端与第三方客户端详细对比 →
          </a>
          <a href="/knowledge/how-to-verify-official-downloads/" class="text-xs font-bold text-[#5B48C4] hover:underline">
            如何校验 GitHub 官方安装包安全 →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
