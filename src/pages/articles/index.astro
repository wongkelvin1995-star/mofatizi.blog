---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const articles = await getCollection('articles', ({ data }) => !data.draft);
---

<BaseLayout
  title="品牌与客户端深度专题文章库｜魔法梯子"
  description="收录针对 18 家机场品牌的客户端兼容真相、Nextin 识别码汇总、Clash 第三方订阅政策解析及套餐选购避坑专题文章。"
  canonicalPath="/articles/"
>
  <section class="bg-magic-hero border-b border-[#E2E8F0] py-10 sm:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: '首页', href: '/' }, { label: '专题文章库' }]} />
      <h1 class="text-3xl font-extrabold text-[#252D49] sm:text-4xl">品牌与客户端深度专题文章</h1>
      <p class="mt-3 max-w-3xl text-base text-[#334155]">
        所有专题均围绕真实品牌客户端政策、协议差异、iOS Nextin 生态与套餐购买注意事项撰写，每篇具备独立搜索意图与可核对的日期依据。
      </p>
    </div>
  </section>

  <section class="bg-magic-articles py-10 sm:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((art) => (
          <a href={`/articles/${art.id}/`} class="magic-card flex flex-col justify-between p-5">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="rounded-full bg-[#F0EBFF] px-2.5 py-0.5 font-semibold text-[#5B48C4]">
                  {art.data.category}
                </span>
                <span class="text-[#64748B]">{art.data.updatedDate}</span>
              </div>
              <h2 class="mt-3 text-base font-bold leading-snug text-[#252D49]">{art.data.title}</h2>
              <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-[#64748B]">{art.data.description}</p>
            </div>
            <span class="mt-4 text-xs font-bold text-[#5B48C4]">阅读完整专题 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
