---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { SITE_CONFIG } from '../../../data/site-config';

const entry = await getEntry('guides', 'clash-tun');
if (!entry) throw new Error('Missing clash-tun');
const { Content, headings } = await render(entry);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    dateModified: entry.data.updatedDate,
    author: { '@type': 'Organization', name: SITE_CONFIG.siteName },
    mainEntityOfPage: `${SITE_CONFIG.domain}/clash/tun/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: entry.data.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArticleLayout
  title={entry.data.title}
  h1={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  canonicalPath="/clash/tun/"
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: 'Clash 知识中心', href: '/clash/' },
    { label: 'Clash TUN 模式设置' },
  ]}
  headings={headings}
  faqs={entry.data.faqs}
  sources={entry.data.sources}
  relatedLinks={[
    { label: '系统代理与 TUN 差异', href: '/knowledge/system-proxy-vs-tun/', tag: '底层对比' },
    { label: 'DNS 与 Fake-IP 科普', href: '/knowledge/dns-and-fake-ip-basics/', tag: 'DNS 机制' },
    { label: 'Clash Verge Rev 教程', href: '/clients/clash-verge-rev/', tag: '桌面端百科' },
  ]}
  jsonLd={jsonLd}
>
  <Content />
</ArticleLayout>
