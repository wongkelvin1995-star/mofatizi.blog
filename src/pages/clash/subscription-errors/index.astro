---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { SITE_CONFIG } from '../../../data/site-config';

const entry = await getEntry('guides', 'clash-subscription-errors');
if (!entry) throw new Error('Missing clash-subscription-errors');
const { Content, headings } = await render(entry);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.publishDate,
    dateModified: entry.data.updatedDate,
    author: { '@type': 'Organization', name: SITE_CONFIG.siteName },
    mainEntityOfPage: `${SITE_CONFIG.domain}/clash/subscription-errors/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: entry.data.faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<ArticleLayout
  title={entry.data.title}
  h1={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  canonicalPath="/clash/subscription-errors/"
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: 'Clash 知识中心', href: '/clash/' },
    { label: 'Clash 订阅更新失败' },
  ]}
  headings={headings}
  faqs={entry.data.faqs}
  sources={entry.data.sources}
  relatedLinks={[
    { label: '节点列表为空排查', href: '/knowledge/empty-node-list-troubleshooting/', tag: '空列表排错' },
    { label: 'Clash 订阅管理教程', href: '/clash/subscription/', tag: '订阅基础' },
    { label: 'Clash 兼容机场名录', href: '/clash/airports/', tag: '政策核查' },
  ]}
  jsonLd={jsonLd}
>
  <Content />
</ArticleLayout>
